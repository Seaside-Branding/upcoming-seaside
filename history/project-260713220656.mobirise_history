 type=\"checkbox\" title=\"Center Cards\" name=\"centerCards\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"checkbox\" name=\"showShadow\" title=\"Enable Shadow\" checked>\n        <input type=\"range\" name=\"shadowBlur\" title=\"Shadow Blur\" min=\"0\" max=\"100\" step=\"1\" value=\"30\" condition=\"showShadow\" inline>\n        <input type=\"range\" name=\"shadowOpacity\" title=\"Shadow Intensity\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.3\" condition=\"showShadow\" inline>\n        <input type=\"range\" name=\"hoverLift\" title=\"Hover Lift\" min=\"0\" max=\"50\" step=\"1\" value=\"8\" inline>\n        <input type=\"range\" name=\"borderRadius\" title=\"Rounding\" min=\"0\" max=\"100\" step=\"1\" value=\"19\" inline>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\" checked>\n        <input type=\"checkbox\" name=\"transparent\" title=\"Transparent BG\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#ff8f7a\" condition=\"(transparent==false)\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background3-5.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#550000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <div class=\"d-flex justify-content-center align-items-center mb-0\">\n                <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Meet the judges!</b></h4>\n                <div class=\"mbr-section-btn ms-4\" mbr-if=\"collapsible\">\n                    <a class=\"btn btn-primary display-4\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#team-collapse-{{alphabet}}\" data-bs-target=\"#team-collapse-{{alphabet}}\" aria-expanded=\"true\" aria-controls=\"team-collapse-{{alphabet}}\">\n                        <span mbr-icon class=\"mbr-iconfont\" style=\"margin:auto;\">\n                            <svg viewBox=\"0 0 512 512\" width=\"1em\" height=\"1em\" fill=\"currentColor\">\n                                <path d=\"M256 294.1L383 167c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9l-144 144c-9.4 9.4-24.6 9.4-33.9 0l-144-144c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0L256 294.1z\"></path>\n                            </svg>\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <h1 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">from ZIFF's 1st edition</h1>\n        </div>\n        <div id=\"team-collapse-{{alphabet}}\" class=\"collapse show\" mbr-class=\"{'show': !collapsed}\">\n            <div class=\"row mt-4\">\n            \n            \n            \n            <div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}} active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/corinauteu.webp\" alt=\"Corina\" title data-slide-to=\"8\" data-bs-slide-to=\"8\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h1 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Corina Șuteu</h1>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\">\n                            <i>Card Subtitle</i>\n                        </h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"text-judge\" data-app-selector=\".mbr-text, .mbr-section-btn\">Corina Șuteu is an international cultural consultant and cultural policy expert with an international career spanning over 30 years in the arts and culture field. She was Minister of Culture in Romania and Director of the Romanian Cultural Institute in New York. Among many other major projects in various sectors of the arts, she founded two film festivals that she produces and whose president she is: Making Waves: New Romanian Cinema and fARAD, an international documentary film festival in Arad. Author of books on cultural management, author of articles in the magazine 22, Dilema, Observator Cultural and international magazines specialized in cultural policies, Corina Șuteu curates the space and programs of Insula 42 and works as an expert for various organizations in Romania and abroad.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                        <a href class=\"btn btn-primary item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">Learn\n                            more</a>\n                    </div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mihaimanescu.webp\" alt=\"Mihai\" title data-slide-to=\"9\" data-bs-slide-to=\"9\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h1 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Mihai Mănescu</h1>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\">\n                            <i>Card Subtitle</i>\n                        </h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"text-judge\" data-app-selector=\".mbr-text, .mbr-section-btn\">Mihai Manescu is a screenwriter, author and communication specialist, PhD in Film and Media, founder of Sustin.org. He brings over a decade of teaching and storytelling expertise to our jury, blending hero’s journey insight with film industry and NGO experience.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                        <a href class=\"btn btn-primary item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">Learn\n                            more</a>\n                    </div>\n                </div>\n            </div><div class=\"item features-image сol-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/paulatudorcmrzan.webp\" alt=\"Paula\" title data-slide-to=\"10\" data-bs-slide-to=\"10\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h1 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Paula Tudor Cămîrzan</h1>\n                        <h6 class=\"item-subtitle mbr-fonts-style mt-1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-subtitle\" mbr-if=\"showCardSubtitle\">\n                            <i>Card Subtitle</i>\n                        </h6>\n                        <p class=\"mbr-text mbr-fonts-style mt-3\" mbr-if=\"showText\" mbr-theme-style=\"text-judge\" data-app-selector=\".mbr-text, .mbr-section-btn\">Paula Tudor Cămîrzan is a cultural manager and documentary film producer, vice president of the Antistatic Association and coordinator of the Via Danubiana project. She has international experience in documentary production and development, with studies in documentary film and visual anthropology.</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                        <a href class=\"btn btn-primary item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">Learn\n                            more</a>\n                    </div>\n                </div>\n            </div>\n    </div>\n  </div>\n</div>\n</section>",
