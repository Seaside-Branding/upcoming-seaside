"checkbox\" title=\"Center Cards\" name=\"centerCards\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Subtitle\">\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"checkbox\" name=\"showShadow\" title=\"Enable Shadow\" checked>\n        <input type=\"range\" name=\"shadowBlur\" title=\"Shadow Blur\" min=\"0\" max=\"100\" step=\"1\" value=\"30\" condition=\"showShadow\" inline>\n        <input type=\"range\" name=\"shadowOpacity\" title=\"Shadow Intensity\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.3\" condition=\"showShadow\" inline>\n        <input type=\"range\" name=\"hoverLift\" title=\"Hover Lift\" min=\"0\" max=\"50\" step=\"1\" value=\"8\" inline>\n        <input type=\"range\" name=\"borderRadius\" title=\"Rounding\" min=\"0\" max=\"100\" step=\"1\" value=\"19\" inline>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\" checked>\n        <input type=\"checkbox\" name=\"transparent\" title=\"Transparent BG\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#550000\" condition=\"(transparent==false)\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background3-5.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ff8f7a\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overla