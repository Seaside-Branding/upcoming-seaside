          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tnp-newsletter-section\">\n  <div class=\"container\">\n    <div class=\"row justify-content-center\">\n      <div class=\"col-12 col-md-8 col-lg-6\">\n        \n        <!-- Card Wrapper -->\n        <div class=\"tnp-card-wrapper\">\n          \n          <h2 class=\"mbr-section-title mbr-fonts-style align-center mb-2\" mbr-theme-style=\"display-2\">\n            Join Our Newsletter\n          </h2>\n          <p class=\"mbr-section-subtitle mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-7\">\n            Stay updated with the latest news from ZIFF\n          </p>\n\n          <form method=\"post\" action=\"https://zoomin-filmfest.com/blog/wp-admin/admin-ajax.php?action=tnp&amp;na=s\" class=\"mbr-form\">\n            <input type=\"hidden\" name=\"nlang\" value=\"\">\n\n            <!-- First Name Field -->\n            <div class=\"form-group mb-3\">\n              <label for=\"tnp-firstname\" class=\"form-label mbr-fonts-style\" mbr-theme-style=\"display-7\">First Name</label>\n              <input class=\"form-control tnp-name mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"text\" name=\"nn\" id=\"tnp-firstname\" placeholder=\"Your name\">\n            </div>\n\n            <!-- Email Field -->\n            <div class=\"form-group mb-3\">\n              <label for=\"tnp-email\" class=\"form-label mbr-fonts-style\" mbr-theme-style=\"display-7\">Email Address</label>\n              <input class=\"form-control tnp-email mbr-fonts-style\" mbr-theme-style=\"display-7\" type=\"email\" name=\"ne\" id=\"tnp-email\" placeholder=\"example@zoomin-filmfest.com\" required=\"\">\n            </div>\n\n            <!-- Privacy Policy Checkbox -->\n            <div class=\"form-check mb-4\">\n              <input class=\"form-check-input tnp-privacy\" type=\"checkbox\" name=\"ny\" id=\"tnp-privacy\" required=\"\">\n              <label class=\"form-check-label mbr-fonts-style\" mbr-theme-style=\"display-7\" for=\"tnp-privacy\">\n                I accept the <a href=\"https://zoomin-filmfest.com/privacy\" target=\"_blank\">privacy policy</a>\n              </label>\n            </div>\n\n            <!-- Subscribe Button -->\n            <div class=\"mbr-section-btn align-center\">\n              <button type=\"submit\" class=\"btn btn-primary tnp-submit mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                Subscribe\n              </button>\n            </div>\n\n          </form>\n\n        </div>\n\n      </div>\n    </div>\n  </div>\n</section>",
