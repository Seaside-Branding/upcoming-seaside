nt-weight: 700;\n    font-size: 1rem;\n    cursor: pointer;\n    transition: all 0.3s ease;\n  }\n  #global-newsletter-popup .btn-submit:hover {\n    color: #ffffff;\n    opacity: 0.9;\n  }\n</style>\n\n<div id=\"global-newsletter-popup\">\n  <div class=\"popup-card\">\n    <button type=\"button\" class=\"popup-close\" onclick=\"closeNewsletterPopup()\">×</button>\n    <h2>Join Our Newsletter</h2>\n    <p>Get festival updates directly in your inbox</p>\n    \n    <form method=\"post\" action=\"https://zoomin-filmfest.com/blog/wp-admin/admin-ajax.php?action=tnp&na=s\">\n      <input type=\"hidden\" name=\"nlang\" value=\"\">\n\n      <div class=\"form-group\">\n        <label for=\"global-tnp-firstname\">First Name</label>\n        <input type=\"text\" name=\"nn\" id=\"global-tnp-firstname\" placeholder=\"Your name\">\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"global-tnp-email\">Email Address</label>\n        <input type=\"email\" name=\"ne\" id=\"global-tnp-email\" placeholder=\"example@zoomin-filmfest.com\" required>\n      </div>\n\n      <div class=\"form-check\">\n        <input type=\"checkbox\" name=\"ny\" id=\"global-tnp-privacy\" required>\n        <label for=\"global-tnp-privacy\" style=\"margin:0;\">\n          I accept the <a href=\"https://zoomin-filmfest.com/privacy\" target=\"_blank\">privacy policy</a>\n        </label>\n      </div>\n\n      <button type=\"submit\" class=\"btn-submit\">Subscribe</button>\n    </form>\n  </div>\n</div>\n\n<script>\n  function closeNewsletterPopup() {\n    document.getElementById('global-newsletter-popup').style.display = 'none';\n  }\n\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    // Displays once per browser session after 2 seconds\n    if (!sessionStorage.getItem('ziff_newsletter_global_shown')) {\n      setTimeout(function() {\n        var popup = document.getElementById('global-newsletter-popup');\n        if (popup) {\n          popup.style.display = 'flex';\n  