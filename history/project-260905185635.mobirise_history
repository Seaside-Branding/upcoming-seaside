          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer1\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" global once=\"footers\" mbr-class=\"{\n    'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n    <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n    <input type=\"color\" title=\"Color\" value=\"#DCDEFF\" name=\"icon\" condition=\"showSocial\">\n    <input type=\"color\" title=\"Active Color\" value=\"#FF8F7A\" condition=\"showSocial\" name=\"active\">\n    <input type=\"color\" title=\"BG\" value=\"#241E4E\" name=\"iconBg\" condition=\"showSocial\">\n\n    <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n    <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n    <header>Color</header>\n    <input type=\"color\" title=\"Container\" name=\"row\" value=\"#550000\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#550000\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#241E4E\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n  </mbr-parameters>\n\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row mbr-white align-items-start\">\n      \n      <!-- Left Column: Navigation Quick Links -->\n      <div class=\"col-12 col-md-8\">\n        <div class=\"row g-3\">\n          <div class=\"col-4\">\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-2\"><b>Company</b></h5>\n            <ul class=\"list-unstyled footer-list mb-0\">\n              <li><a href=\"about.html\" class=\"footer-link\">About</a></li>\n              <li><a href=\"press.html\" class=\"footer-link\">Press</a></li>\n              <li><a href=\"team.html\" class=\"footer-link\">Team</a></li>\n              <li><a href=\"join.html\" class=\"footer-link\">Join the team</a></li>\n              <li><a href=\"donate.html\" class=\"footer-link highlight-link\">Donate!</a></li>\n              <li><a href=\"contact.html\" class=\"footer-link\">Contact</a></li>\n              <li><a href=\"partners.html\" class=\"footer-link\">Our Partners</a></li>\n            </ul>\n          </div>\n\n          <div class=\"col-4\">\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-2\"><b>Features</b></h5>\n            <ul class=\"list-unstyled footer-list mb-0\">\n              <li><a href=\"submit.html\" class=\"footer-link\">Submissions</a></li>\n              <li><a href=\"past-movies.html\" class=\"footer-link\">Past movies</a></li>\n              <li><a href=\"gallery.html\" class=\"footer-link\">Gallery</a></li>\n              <li><a href=\"collabs.html\" class=\"footer-link\">Collaborations</a></li>\n              <li><a href=\"register.html\" class=\"footer-link\">Register</a></li>\n              <li><a href=\"https://zoomin-filmfest.com/blog\" class=\"footer-link\">Blog</a></li>\n            </ul>\n          </div>\n\n          <div class=\"col-4\">\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-2\"><b>Support &amp; Legal</b></h5>\n            <ul class=\"list-unstyled footer-list mb-0\">\n              <li><a href=\"help.html\" class=\"footer-link\">Help</a></li>\n              <li><a href=\"contact.html\" class=\"footer-link\">Contacts</a></li>\n              <li><a href=\"report.html\" class=\"footer-link\">Report</a></li>\n              <li><a href=\"rules.html\" class=\"footer-link\">Rules</a></li>\n              <li><a href=\"/legal\" class=\"footer-link\">Legal Info</a></li>\n              <li><a href=\"/privacy\" class=\"footer-link\">Privacy Policy</a></li>\n              <li><a href=\"/tos\" class=\"footer-link\">Terms of Service</a></li>\n            </ul>\n          </div>\n        </div>\n      </div>\n\n      <!-- Right Column: Direct CTA & ANPC Links -->\n      <div class=\"col-12 col-md-4 mt-3 mt-md-0 d-flex flex-column align-items-md-end align-items-start justify-content-between\">\n        <div mbr-buttons mbr-if=\"showButtons\" class=\"mbr-section-btn mb-3 my-0\">\n          <a class=\"btn btn-register\" href=\"register.html\">Register Now</a>\n        </div>\n\n        <!-- Compact ANPC Banners -->\n        <div class=\"anpc-banners my-2 text-md-end\">\n          <a href=\"https://anpc.ro/ce-este-sal/\" target=\"_blank\" rel=\"nofollow\">\n            <img loading=\"lazy\" src=\"https://e-advertising.co/anpc/eadv-sal.png\" alt=\"SAL\">\n          </a>\n          <a href=\"https://ec.europa.eu/consumers/odr\" target=\"_blank\" rel=\"nofollow\">\n            <img loading=\"lazy\" src=\"https://e-advertising.co/anpc/eadv-sol.png\" alt=\"SOL\">\n          </a>\n        </div>\n      </div>\n\n      <!-- Divider line -->\n      <div class=\"col-12 my-3\">\n        <hr class=\"footer-hr m-0\">\n      </div>\n\n      <!-- Compact Horizontal Inline Team Credits -->\n      <div class=\"col-12 text-center mb-2\">\n        <p class=\"credits-inline mb-0\">\n          <span class=\"credits-label\">Powered by:</span>\n<a href=\"https://marcparaschiv.com\" target=\"_blank\" class=\"footer-link\">Marc Paraschiv</a> • \n          <span>Rares Stanciu</span> • \n          <span>Johanna Croci</span> • \n          <span>Rita Bartos</span> &nbsp;</p>\n      </div>\n\n      <!-- Compact Copyright -->\n      <div class=\"col-12 text-center\" mbr-if=\"showCopyright\">\n        <p class=\"copyright mb-0\">\n          © [JS_CODE_0]<strong>Asociația Cadru cu Cadru</strong>. All rights reserved. <strong>Zoom In Film Festival (ZIFF)</strong> is a registered trademark.<br>\n          Commercial management, ticketing &amp; website development powered by <a href=\"https://seasidebranding.com\" class=\"footer-link fw-bold\" target=\"_blank\">Seaside Branding</a>.\n        </p>\n      </div>\n\n    </div>\n  </div>\n</section>",
